# Web5.blog Environment Configuration (example)
# Copy to .env and fill in your values

# Database (SQLite)
DATABASE_URL="file:./db/prod.db"

# DeepSeek API (primary LLM for Eidolon Writer)
DEEPSEEK_API_KEY=sk-you…-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Fallback: z-ai-web-dev-sdk used when API key not configured

# Public site origin (used by discovery manifests and OpenAPI)
NEXT_PUBLIC_SITE_URL=https://web5.blog

# Public source repository; when set, the footer GitHub icon links to it.
# Leave empty while the repository is private.
NEXT_PUBLIC_SOURCE_URL=

# Telegram bot token (BotFather). Never commit the real value.
TG_BOT_TOKEN=

# x402 paid reads
# Set to false to pause all paid content calls with HTTP 503.
X402_PAYMENTS_ENABLED=true
# Require a funded BackupWallet balance before accepting a signed voucher.
# Only set to false for local testing without funds.
X402_REQUIRE_PREPAID=true

# Arc RPC (optional overrides)
# ARC_MAINNET_RPC=https://rpc.mainnet.arc.io
# ARC_TESTNET_RPC=https://rpc.testnet.arc.io
