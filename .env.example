# Web5.blog Environment Configuration (example)
# Copy to .env and fill in your values

# Database (SQLite)
DATABASE_URL="file:./db/prod.db"

# DeepSeek API (primary LLM for Eidolon Writer)
DEEPSEEK_API_KEY=sk-you…-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Fallback: z-ai-web-dev-sdk used when API key not configured

# Public site origin (used by discovery manifests and OpenAPI)
NEXT_PUBLIC_SITE_URL=https://web5.blog

# Build/runtime metadata for /api/daemon/health
APP_VERSION=
APP_COMMIT=

# Admin authentication (generate long random values; never commit real ones)
# ADMIN_SESSION_SECRET must be at least 32 characters.
ADMIN_SESSION_SECRET=
ADMIN_API_KEY=

# Launch switches — all real-money paths are OFF by default until escrow,
# refunds, on-chain confirmation and payout signing are verified.
MONEY_FLOWS_ENABLED=false
WITHDRAWALS_ENABLED=false
AIRDROP_ENABLED=false
X402_DEPOSITS_ENABLED=false
ESCROW_PAYOUTS_ENABLED=false
# Autonomous agents: AUTONOMOUS_AGENTS_ENABLED is the master switch for every
# unattended path (cron tick AND the headless daemon). AGENT_DAEMON_ENABLED only
# turns the in-process daemon on *when the master switch is already on*;
# DISABLE_AGENT_DAEMON=true kills it regardless.
AUTONOMOUS_AGENTS_ENABLED=false
AGENT_DAEMON_ENABLED=false

# ── Vessel 真实身份模式（从 beta 模拟走向真实资金的硬门槛）─────────────
# 默认 false = beta 模拟身份：AA2P 签名仅做结构校验，Prime 授权由模拟预言机签发，
# 标记为 identityReal=false，绝不可用于结算真实资金。
# 设为 true 后，AA2P 签名必须经由真实密码学验签（TEE 公钥 + viem verifyMessage），
# 全新 Vessel 的 Prime 授权必须来自下方预言机；任何未配置项一律 fail-closed（拒绝签发）。
# 开启前必须同时配置 EIDOLON_ORACLE_URL + EIDOLON_ORACLE_TOKEN，并确保 TEE（plvtvs.one）
# 在 AA2P 凭证中随附 aa2pPublicKey。当前生产保持 false。
REAL_VESSEL_IDENTITY=false
# eidolonos.xyz 预言机：查询 Session Key 授权。两者都设置才切换；缺一则新 Vessel 授权 fail-closed。
EIDOLON_ORACLE_URL=
EIDOLON_ORACLE_TOKEN=

# Client-visible mirrors (must be set at build time)
NEXT_PUBLIC_MONEY_FLOWS_ENABLED=false
NEXT_PUBLIC_AIRDROP_ENABLED=false

# Autonomous tick endpoint secret (only needed if AUTONOMOUS_AGENTS_ENABLED=true)
AUTONOMOUS_TICK_SECRET=

# Chain selection. BUILT INTO THE CLIENT: changing it requires a rebuild.
# arc-mainnet (5042) | arc-testnet (5042002)
NEXT_PUBLIC_ACTIVE_CHAIN=arc-mainnet
# Escrow vault shown to the browser (testnet rehearsal only; empty = built-in default)
NEXT_PUBLIC_ESCROW_VAULT_ADDRESS=

# Server-side money addresses (runtime; empty = built-in mainnet treasury)
TREASURY_ADDRESS=
ESCROW_VAULT_ADDRESS=

# Settlement / escrow payouts (safe defaults; all money movement stays off)
# MONEY_FLOWS_ENABLED and ESCROW_PAYOUTS_ENABLED live in the launch switches
# above; both must be true before any payout can move funds.
REFUNDS_ENABLED=false
# Receives the 20% protocol fee. Empty = fee retained in treasury (RETAINED, no transfer).
PLATFORM_FEE_ADDRESS=
# Server-only signer for treasury payouts. Never commit a real key.
# Ignored as soon as KMS_SIGNER_URL + KMS_SIGNER_TOKEN are set; delete it from
# the VPS once the remote signer is live (P0, docs/HOT_WALLET.md).
TREASURY_PAYOUT_PRIVATE_KEY=
# ── Hot-wallet isolation (P0, checklist 4.3) ─────────────────────
# Holding ceiling for the treasury hot wallet. Env may only LOWER it (max 20);
# a balance above the ceiling refuses every payout until it is swept.
HOT_WALLET_MAX_USDC=20
# Operating float kept behind when planning a sweep to the cold address
# (covers gas: USDC is the gas token on Arc).
HOT_WALLET_SWEEP_RESERVE_USDC=5
# Remote signer (KMS/HSM sidecar). Set BOTH url AND token to switch away from
# the local key. A half-configuration fails closed -- it never falls back to
# TREASURY_PAYOUT_PRIVATE_KEY. Wire contract + runbook: docs/HOT_WALLET.md
KMS_SIGNER_URL=
KMS_SIGNER_TOKEN=
# Optional expected signer address; also enables the treasury match check.
KMS_SIGNER_ADDRESS=
# Per-transfer USDC cap; values above 5 are clamped to 5.
PAYOUT_SINGLE_CAP_USDC=5
# Rolling 24h payout cap; values above 25 are clamped to 25.
PAYOUT_DAILY_CAP_USDC=25
# Dispute window (hours) after verification before settlement is allowed.
SETTLEMENT_WINDOW_HOURS=72
# Bearer secret for the settlement cron endpoint. Empty disables scheduled settlement.
SETTLEMENT_CRON_SECRET=
# Let the agent daemon auto-claim 80/20 bounty payouts (keep false until audited).
AGENT_DAEMON_AUTOCLAIM=false

# Public source repository; when set, the footer GitHub icon links to it.
# Leave empty while the repository is private.
NEXT_PUBLIC_SOURCE_URL=

# Telegram bot token (BotFather). Never commit the real value.
TG_BOT_TOKEN=

# Telegram public-channel broadcast queue
# Shared secret between the web server and the bot process (min 16 chars).
# Unset = the whole feature is inert: /api/broadcast/claim and /api/broadcast/ack
# answer 503, order creation enqueues nothing, and scripts/tg-bot.mjs posts
# nothing. Production currently has this unset. Never commit the real value.
TG_BROADCAST_SECRET=
# Public channel @username or numeric chat id the bot posts bounty notices to.
# Unset = disabled (needs TG_BROADCAST_SECRET as well). Production: unset.
TG_CHANNEL_ID=
# Optional alias for TG_CHANNEL_ID (first non-empty one wins).
TG_BROADCAST_CHANNEL=
# Base URL the BOT process calls (/api/broadcast/claim + /ack). Leave empty to
# use https://web5.blog. Note: the link inside the post is built server-side
# from NEXT_PUBLIC_SITE_URL, never from this value.
TG_BROADCAST_SITE_URL=
# Bot poll interval in ms (clamped to 5000..86400000).
TG_BROADCAST_POLL_MS=60000
# Hard cap of channel posts per poll cycle (clamped to 1..20).
TG_BROADCAST_MAX_SENDS_PER_RUN=5
# Attempts per message before the record is marked FAILED (clamped to 1..8).
TG_BROADCAST_MAX_RETRIES=3
# Exponential backoff floor/ceiling in ms; Telegram retry_after always wins,
# capped by the ceiling.
TG_BROADCAST_BASE_BACKOFF_MS=1000
TG_BROADCAST_MAX_BACKOFF_MS=120000
# Retained broadcast records in SystemConfig; PENDING work is never evicted,
# a newcomer is dropped when the queue is full (clamped to 1..2000).
BROADCAST_QUEUE_MAX_RECORDS=200
# Claims per order before it is skipped for good (a crashed bot must not
# post the same bounty forever).
BROADCAST_MAX_ATTEMPTS=3
# How long a claimed-but-unacked record stays reserved before it may be
# re-claimed (ms). Keep it longer than one bot cycle.
BROADCAST_CLAIM_TTL_MS=600000

# x402 paid reads
# Set to false to pause all paid content calls with HTTP 503.
# NOTE: these flags are now centralized in src/lib/launch/flags.ts.
# X402_PAYMENTS_ENABLED is gated by MONEY_FLOWS_ENABLED (master switch) via
# X402_PAYMENTS_LIVE, so it can only go live when both are enabled.
X402_PAYMENTS_ENABLED=false
# Require a funded BackupWallet balance before accepting a signed voucher.
# Only set to false for local testing without funds.
X402_REQUIRE_PREPAID=true

# Cloudflare Web Analytics token (optional, public by design)
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
# Fraction of Core Web Vitals events sent to /api/rum (0 disables sampling)
NEXT_PUBLIC_RUM_SAMPLE_RATE=0.2

# Arc RPC (optional overrides)
# ARC_MAINNET_RPC=https://rpc.mainnet.arc.io
# ARC_TESTNET_RPC=https://rpc.testnet.arc.io
